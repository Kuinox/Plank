<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\K4os.Compression.LZ4\src\K4os.Compression.LZ4\**\*.cs"
             Exclude="..\K4os.Compression.LZ4\src\K4os.Compression.LZ4\obj\**\*.cs" />
  </ItemGroup>

  <Target Name="RequireVendoredLz4" BeforeTargets="CoreCompile" Condition="!Exists('$(MSBuildProjectDirectory)/../K4os.Compression.LZ4/src/K4os.Compression.LZ4/LZ4Codec.cs')">
    <Error Text="K4os LZ4 source is missing. Run git submodule update --init --recursive." />
  </Target>
</Project>
