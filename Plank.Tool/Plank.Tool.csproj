<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>plank</ToolCommandName>
    <PackageId>Plank.Tool</PackageId>
    <Description>Inspect and profile Parquet files.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework" Version="5.7.13" />
    <EmbeddedResource Include="Querying/*.py" />
    <EmbeddedResource Include="Querying/request_report.html" />
    <EmbeddedResource Include="../tools/profile-viewer/index.html" LogicalName="Plank.Tool.ReportViewer.html" />
    <ProjectReference Include="../Plank/Plank.csproj" />
  </ItemGroup>
</Project>
