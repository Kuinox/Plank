<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <NoWarn>$(NoWarn);CA1822;PLANK001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ParquetSharp" Version="24.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plank\Plank.csproj" />
    <!-- The row API is reached through generated code, so the fuzzer needs the
         generator to have row types to drive at all: the writer pipeline is
         generic over a generated slot type and abstract over four generated
         methods, none of which a fuzzer can synthesize at runtime. -->
    <ProjectReference Include="..\Plank.SourceGen\Plank.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
