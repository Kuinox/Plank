{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "Plank/Plank.csproj"
          ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "nested",
      "memberLayout": "samePage"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "*.md",
          "toc.yml",
          "articles/**.md"
        ]
      },
      {
        "files": [
          "api/**.yml"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "plank-template"
    ],
    "globalMetadata": {
      "_appName": "Plank",
      "_appTitle": "Plank docs",
      "_appLogoPath": "logo.svg",
      "_appFaviconPath": "logo.svg",
      "_appFooter": "<span class=\"plank-footer-links\"><a href=\"https://github.com/Kuinox/Plank\">GitHub</a><a href=\"https://www.nuget.org/packages/Plank\">NuGet</a><a href=\"https://github.com/Kuinox/Plank/blob/master/LICENSE\">MIT</a></span>",
      "_enableSearch": true,
      "titleSuffix": "Plank"
    }
  }
}
