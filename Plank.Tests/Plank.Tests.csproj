<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.1.1" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="Parquet.Net" Version="6.0.3" />
    <PackageReference Include="ParquetSharp" Version="24.0.0" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="TUnit" Version="1.12.15" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Reading\Fixtures\*.parquet">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Reading\Fixtures\Corpus\*.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The apache/parquet-testing corpus is a submodule of several megabytes, so it is
       read in place rather than copied to the output directory. Its location has to
       survive into the test assembly somehow, and a compile-time constant is exact
       where walking up from AppContext.BaseDirectory looking for a directory name is
       guesswork. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ParquetTestingRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\third_party\parquet-testing'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plank\Plank.csproj" />
    <ProjectReference Include="..\Plank.Fuzzing\Plank.Fuzzing.csproj" />
    <ProjectReference Include="..\Plank.SourceGen\Plank.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
